# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas free tier, or local mongodb://localhost:27017/foodapp)
MONGO_URI=mongodb://localhost:27017/foodorderingapp

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Default admin (used by seed script)
ADMIN_EMAIL=admin@foodapp.com
ADMIN_PASSWORD=Admin@123
